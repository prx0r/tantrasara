{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["pass", "score", "beats", "timings", "audio", "script", "niggles"],
  "properties": {
    "pass": {"type": "boolean"}, "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "beats": {"type": "array", "items": {"type": "object", "required": ["bid", "t", "defect", "fix"], "additionalProperties": false,
      "properties": {"bid": {"type": "string"}, "t": {"type": "number"}, "defect": {"type": "string"}, "fix": {"type": "string"}}}},
    "timings": {"type": "array", "items": {"type": "object", "required": ["key", "expected", "seen"], "additionalProperties": false,
      "properties": {"key": {"type": "string"}, "expected": {"type": "number"}, "seen": {"type": "number"}}}},
    "audio": {"$ref": "#/$defs/issues"}, "script": {"$ref": "#/$defs/issues"}, "niggles": {"$ref": "#/$defs/issues"}
  },
  "$defs": {"issues": {"type": "array", "items": {"type": "object", "required": ["t", "defect", "fix"], "additionalProperties": false,
    "properties": {"t": {"type": "number"}, "defect": {"type": "string"}, "fix": {"type": "string"}}}}}
}
