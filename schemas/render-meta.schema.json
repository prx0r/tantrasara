{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenanced video part metadata",
  "type": "object", "required": ["cuts", "duration", "white_pct", "coverage", "cues", "bids", "drops", "provenance"],
  "additionalProperties": false,
  "properties": {
    "cuts": {"type": "integer", "minimum": 1},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "white_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "coverage": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}},
    "cues": {"type": "array", "items": {"type": "object", "required": ["t", "key"], "additionalProperties": false,
      "properties": {"t": {"type": "number", "minimum": 0}, "key": {"type": "string", "minLength": 1}}}},
    "bids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^b[1-9][0-9]*$"}},
    "drops": {"type": "object", "additionalProperties": {"type": "object", "required": ["pause", "at"], "additionalProperties": false,
      "properties": {"pause": {"type": "number", "exclusiveMinimum": 0}, "at": {"type": "number", "minimum": 0}}}},
    "provenance": {
      "type": "object", "required": ["inputs", "inputs_sha256", "video_sha256", "subs_sha256"], "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "object", "required": ["version", "lane", "unit", "bids", "storyboard", "glossary", "approval", "drops", "static", "audio"],
          "additionalProperties": false,
          "properties": {
            "version": {"const": 1}, "lane": {"enum": ["tantrasara", "shiva"]}, "unit": {"type": "string"},
            "bids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "storyboard": {"$ref": "#/$defs/hash"}, "glossary": {"$ref": "#/$defs/hash"},
            "approval": {"$ref": "#/$defs/hash"}, "drops": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
            "static": {"type": "object", "additionalProperties": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}},
            "audio": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
              "properties": {"path": {"type": "string", "pattern": "\\S"}, "sha256": {"$ref": "#/$defs/hash"}}}}
          }
        },
        "inputs_sha256": {"$ref": "#/$defs/hash"}, "video_sha256": {"$ref": "#/$defs/hash"}, "subs_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
