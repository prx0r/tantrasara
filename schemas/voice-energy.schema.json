{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "storyboard_sha256", "video_sha256", "subs_sha256", "checker_sha256", "checks", "pass", "limitation"],
  "properties": {
    "version": {"const": 1},
    "storyboard_sha256": {"$ref": "#/$defs/hash"}, "video_sha256": {"$ref": "#/$defs/hash"},
    "subs_sha256": {"$ref": "#/$defs/hash"}, "checker_sha256": {"$ref": "#/$defs/hash"},
    "pass": {"type": "boolean"}, "limitation": {"type": "string", "pattern": "\\S"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["voice", "samples", "audible", "pass"],
      "properties": {
        "voice": {"enum": ["granny", "man", "verse"]}, "audible": {"type": "integer", "minimum": 0}, "pass": {"type": "boolean"},
        "samples": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["bid", "t", "mean_db"], "properties": {
            "bid": {"type": "string", "pattern": "^b[1-9][0-9]*$"},
            "t": {"type": "number", "minimum": 0}, "mean_db": {"type": "number"}
          }}}
      }
    }}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
