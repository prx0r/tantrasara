{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Render approval — historical format",
  "type": "object", "required": ["date", "storyboard_sha", "glossary_sha", "note"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "format": "date"},
    "storyboard_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "glossary_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "note": {"type": "string", "pattern": "\\S"}
  }
}
