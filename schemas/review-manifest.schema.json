{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["chapter", "date", "blocks", "storyboard_sha", "glossary_sha", "confirmed_terms", "approved", "storyboard_view_sha", "timeline_sha", "sheet_sha", "publisher_sha", "timeline_builder_sha"],
  "properties": {
    "chapter": {"type": "string", "pattern": "^(0[1-9]|1[0-9]|2[0-2]|s[0-7][0-9])$"},
    "date": {"type": "string", "format": "date"}, "blocks": {"type": "integer", "minimum": 2},
    "storyboard_sha": {"$ref": "#/$defs/hash"}, "glossary_sha": {"$ref": "#/$defs/hash"},
    "storyboard_view_sha": {"$ref": "#/$defs/hash"}, "timeline_sha": {"$ref": "#/$defs/hash"},
    "sheet_sha": {"$ref": "#/$defs/hash"}, "publisher_sha": {"$ref": "#/$defs/hash"},
    "timeline_builder_sha": {"$ref": "#/$defs/hash"},
    "approved": {"const": false},
    "confirmed_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
