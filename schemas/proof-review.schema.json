{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "proof_manifest_sha256", "reviewer", "reviewed_on", "frames"],
  "properties": {
    "version": {"const": 1},
    "proof_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "minLength": 2, "pattern": "\\S"},
    "reviewed_on": {"type": "string", "format": "date"},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "verdict", "observation"],
      "properties": {
        "file": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+\\.png$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verdict": {"enum": ["pass", "fail", "unreviewed"]},
        "observation": {"type": "string", "minLength": 10, "pattern": "\\S"}
      }
    }}
  }
}
