   "id": "b121",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "But the yogin is going to investigate that distinction through the wheel of Bhairava.",
   "directed": "But the yogin is going to investigate that distinction through the wheel of Bhairava."
  },
  {
   "id": "b122",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And the object is going to undergo four transformations.",
