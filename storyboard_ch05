   "directed": "[slowly] Sarvātmatā."
  },
  {
   "id": "b264",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The condition of being the Self of all.",
   "directed": "The condition of being the Self of all."
  },
  {
   "id": "b265",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "One no longer experiences some independently existing other thing that must be acquired to achieve completeness.",
   "directed": "One no longer experiences some independently existing other thing that must be acquired to achieve completeness."
