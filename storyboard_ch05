  {
   "id": "b124",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Sṛṣṭi — Manifestation.",
   "directed": "Sṛṣṭi — Manifestation."
  },
  {
   "id": "b125",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The moon.",
   "directed": "The moon."
  },
  {
   "id": "b126",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Soma.",
   "directed": "Soma."
  },
  {
   "id": "b127",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The object is filled through the lunar power of emanation.",
   "directed": "The object is filled through the lunar power of emanation."
  },
