  {
   "id": "b170",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The shape.",
   "directed": "The shape."
  },
  {
   "id": "b171",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And the mind can bring the thing back.",
