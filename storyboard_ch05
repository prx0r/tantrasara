   "id": "b231",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Hṛdaya.",
   "directed": "[slowly] Hṛdaya."
  },
  {
   "id": "b232",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And there, one encounters:",
   "directed": "[short pause] And there, one encounters:"
