   "id": "b252",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "It’s a contemplative account of the outward movement of experience.",
   "directed": "It’s a contemplative account of the outward movement of experience."
