  {
   "id": "b249",
   "section": "Tantrasāra — Chapter 5",
   "type": "dialogue",
   "voice": "granny",
   "text": "“I’m here, and the thing is over there.”",
   "directed": "[short pause] “I’m here, and the thing is over there.”"
  },
  {
   "id": "b250",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "But through this practice, you’re examining how the movement toward the apparent object unfolds within awareness itself.",
   "directed": "But through this practice, you’re examining how the movement toward the apparent object unfolds within awareness itself."
