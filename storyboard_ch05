  {
   "id": "b452",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Now here’s the extraordinary philosophical point behind that last one.",
   "directed": "Now here’s the extraordinary philosophical point behind that last one."
