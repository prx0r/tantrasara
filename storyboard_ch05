  {
   "id": "b245",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "You see something.",
   "directed": "You see something."
  },
  {
   "id": "b246",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "You hear something.",
   "directed": "You hear something."
  },
  {
   "id": "b247",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "You encounter something.",
   "directed": "You encounter something."
  },
  {
   "id": "b248",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Now ordinarily, you think:",
   "directed": "[short pause] Now ordinarily, you think:"
