   "id": "b228",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Resting in awareness.",
   "directed": "Resting in awareness."
  },
  {
   "id": "b229",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Now watch.",
   "directed": "Now watch."
  },
  {
   "id": "b230",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "First: Śūnya — the void of the Heart\nBefore the outward movement begins, the yogin rests in the Heart.",
   "directed": "First: Śūnya — the void of the Heart\nBefore the outward movement begins, the yogin rests in the Heart."
