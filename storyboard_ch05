   "text": "This isn’t a loyalty card.",
   "directed": "This isn’t a loyalty card."
  },
  {
   "id": "b382",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Because there’s something that unites all six.",
   "directed": "Because there’s something that unites all six."
  },
  {
   "id": "b383",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And it’s not merely a seventh stage added to the end.",
   "directed": "And it’s not merely a seventh stage added to the end."
  },
  {
   "id": "b384",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "7. Jagadānanda — the bliss that never comes and goes\nJagadānanda.",
   "directed": "7. Jagadānanda — the bliss that never comes and goes\nJagadānanda."
  },
  {
   "id": "b385",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The bliss of the entire universe.",
   "directed": "The bliss of the entire universe."
  },
  {
   "id": "b386",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Jagat — world, universe.",
   "directed": "Jagat — world, universe."
  },
  {
   "id": "b387",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Ānanda — bliss.",
   "directed": "Ānanda — bliss."
  },
  {
   "id": "b388",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And here’s why this is so important.",
