  {
   "id": "b713",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Some individuals can attain fullness of understanding spontaneously.",
   "directed": "Some individuals can attain fullness of understanding spontaneously."
