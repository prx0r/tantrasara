  {
   "id": "b389",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "All those previous states involve particular movements or forms of repose.",
   "directed": "All those previous states involve particular movements or forms of repose."
  },
  {
   "id": "b390",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "They arise in relation to the stages of uccāra.",
   "directed": "They arise in relation to the stages of uccāra."
  },
  {
   "id": "b391",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "But jagadānanda is described as:",
