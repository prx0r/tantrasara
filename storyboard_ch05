   "id": "b235",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Emptiness.",
   "directed": "Emptiness."
  },
  {
   "id": "b236",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The absence of a particular object occupying attention.",
   "directed": "The absence of a particular object occupying attention."
  },
  {
   "id": "b237",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Now don’t imagine this means you’ve entered some dreadful realm of nothingness.",
   "directed": "Now don’t imagine this means you’ve entered some dreadful realm of nothingness."
  },
  {
   "id": "b238",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "We’re talking about a condition of repose.",
   "directed": "We’re talking about a condition of repose."
  },
  {
   "id": "b239",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The place from which the movement of prāṇa can be contemplated.",
   "directed": "The place from which the movement of prāṇa can be contemplated."
  },
  {
   "id": "b240",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The yogin rests there.",
   "directed": "The yogin rests there."
  },
  {
   "id": "b241",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And then the outward movement begins.",
   "directed": "And then the outward movement begins."
  },
  {
   "id": "b242",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Second: Prāṇa — consciousness goes out\nThe vital energy moves outward.",
   "directed": "Second: Prāṇa — consciousness goes out\nThe vital energy moves outward."
