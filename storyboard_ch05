   "id": "b217",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Prāṇa.",
   "directed": "[slowly] Prāṇa."
  },
  {
   "id": "b218",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Apāna.",
   "directed": "[slowly] Apāna."
  },
  {
   "id": "b219",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Samāna.",
   "directed": "[slowly] Samāna."
  },
  {
   "id": "b220",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Udāna.",
   "directed": "[slowly] Udāna."
  },
  {
   "id": "b221",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Vyāna.",
   "directed": "[slowly] Vyāna."
  },
  {
   "id": "b222",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And these aren’t simply five different names for oxygen.",
   "directed": "And these aren’t simply five different names for oxygen."
  },
  {
   "id": "b223",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Within tantric physiology, they’re five functions of the life-force.",
   "directed": "Within tantric physiology, they’re five functions of the life-force."
  },
  {
   "id": "b224",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Five movements through which embodied consciousness manifests its activity.",
   "directed": "Five movements through which embodied consciousness manifests its activity."
  },
  {
   "id": "b225",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And here’s the extraordinary thing.",
   "directed": "And here’s the extraordinary thing."
  },
  {
   "id": "b226",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Each movement can reveal a different mode of viśrānti.",
   "directed": "Each movement can reveal a different mode of viśrānti."
  },
  {
   "id": "b227",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Repose.",
   "directed": "Repose."
