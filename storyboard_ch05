  {
   "id": "b398",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "It’s the single connecting reality of those different reposes.",
   "directed": "It’s the single connecting reality of those different reposes."
