  {
   "id": "b659",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The supreme consciousness itself.",
   "directed": "The supreme consciousness itself."
  },
  {
   "id": "b660",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "All brought together.",
   "directed": "All brought together."
  },
  {
   "id": "b661",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Not as unrelated entities.",
   "directed": "Not as unrelated entities."
  },
  {
   "id": "b662",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "But as expressions of one underlying power.",
   "directed": "But as expressions of one underlying power."
  },
  {
   "id": "b663",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And Abhinavagupta calls this:",
