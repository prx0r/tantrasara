   "id": "b261",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The apparent outside is gathered inward.",
   "directed": "The apparent outside is gathered inward."
  },
  {
   "id": "b262",
   "section": "Tantrasāra — Chapter 5",
