   "id": "b428",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Arising. Emergence. A kind of elevation.",
   "directed": "Arising. Emergence. A kind of elevation."
  },
  {
   "id": "b429",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Here the practitioner momentarily enters a condition described as niḥśarīratā.",
   "directed": "Here the practitioner momentarily enters a condition described as niḥśarīratā."
