   "type": "narration",
   "voice": "granny",
   "text": "The entire sequence of creation, continuation and dissolution consists, in its essential reality, of consciousness.",
   "directed": "The entire sequence of creation, continuation and dissolution consists, in its essential reality, of consciousness."
  },
  {
   "id": "b184",
   "section": "Tantrasāra — Chapter 5",
   "type": "verse",
   "voice": "verse",
   "text": "Svasaṃvin-mātra-paramārtha.",
   "directed": "[slowly] Svasaṃvin-mātra-paramārtha."
  },
  {
   "id": "b185",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And the freedom through which these things occur?",
