   "text": "Without needing another method.",
   "directed": "Without needing another method."
  },
  {
   "id": "b715",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Their conceptual understanding becomes complete through its own refinement.",
   "directed": "Their conceptual understanding becomes complete through its own refinement."
  },
  {
   "id": "b716",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Lovely.",
   "directed": "[short pause] Lovely."
  },
  {
   "id": "b717",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
