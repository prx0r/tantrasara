  {
   "id": "b707",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And it brings the entire argument back to something surprisingly simple.",
   "directed": "And it brings the entire argument back to something surprisingly simple."
  },
  {
   "id": "b708",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "16. The final verse — stop ranking the methods as if they’re competing\nHere is the actual Sanskrit:",
   "directed": "[short pause] 16. The final verse — stop ranking the methods as if they’re competing\nHere is the actual Sanskrit:"
  },
  {
   "id": "b709",
   "section": "Tantrasāra — Chapter 5",
   "type": "figure",
   "voice": "none",
   "text": "SANSKRIT — CHAPTER FIVE, CONCLUDING VERSE",
   "directed": "SANSKRIT — CHAPTER FIVE, CONCLUDING VERSE"
