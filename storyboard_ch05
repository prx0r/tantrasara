   "id": "b414",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "They’re not a checklist of symptoms you ought to deliberately induce.",
   "directed": "They’re not a checklist of symptoms you ought to deliberately induce."
  },
  {
   "id": "b415",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And experiencing trembling or dizziness by itself certainly doesn’t establish spiritual attainment.",
   "directed": "And experiencing trembling or dizziness by itself certainly doesn’t establish spiritual attainment."
