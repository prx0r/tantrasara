   "id": "b128",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Its appearing is contemplated as the expression of consciousness.",
   "directed": "Its appearing is contemplated as the expression of consciousness."
  },
  {
   "id": "b129",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Not some foreign object mysteriously existing outside awareness.",
   "directed": "Not some foreign object mysteriously existing outside awareness."
  },
  {
   "id": "b130",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "The flower is manifest.",
   "directed": "The flower is manifest."
  },
  {
   "id": "b131",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Second:",
   "directed": "[short pause] Second:"
  },
  {
   "id": "b132",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "Sthiti — Maintenance.",
   "directed": "Sthiti — Maintenance."
  },
  {
   "id": "b133",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
