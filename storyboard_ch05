   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "He isn’t forgetting the remaining methods.",
   "directed": "He isn’t forgetting the remaining methods."
  },
  {
   "id": "b705",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "He’s arranging the teaching.",
   "directed": "He’s arranging the teaching."
  },
  {
   "id": "b706",
   "section": "Tantrasāra — Chapter 5",
   "type": "narration",
   "voice": "granny",
   "text": "And now, after all these magnificent descriptions of fire-wheels, vital energies, subtle bliss, inner centres and mystical phonemes, we arrive at the concluding verse.",
   "directed": "And now, after all these magnificent descriptions of fire-wheels, vital energies, subtle bliss, inner centres and mystical phonemes, we arrive at the concluding verse."
