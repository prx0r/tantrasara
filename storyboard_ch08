  {
   "id": "b23",
   "section": "Tantrasāra — Chapter 8",
   "type": "dialogue",
   "voice": "man",
   "text": "“Abhinava, mate, what exactly ARE these things? Are they substances? Categories? Cosmic departments? Who’s making all of this happen?”",
   "directed": "[short pause] “Abhinava, mate, what exactly ARE these things? Are they substances? Categories? Cosmic departments? Who’s making all of this happen?”"
