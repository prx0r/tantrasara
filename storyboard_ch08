  {
   "id": "b778",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Determination and causal order",
   "directed": "Determination and causal order"
  },
  {
   "id": "b779",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Now, don’t imagine these six coverings are literally pieces of fabric wrapped around your soul.",
   "directed": "Now, don’t imagine these six coverings are literally pieces of fabric wrapped around your soul."
  },
  {
   "id": "b780",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The metaphor concerns how the unlimited powers of consciousness appear restricted.",
   "directed": "The metaphor concerns how the unlimited powers of consciousness appear restricted."
  },
  {
   "id": "b781",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "And the resulting individual, associated with body and subtle faculties, is called:",
   "directed": "[short pause] And the resulting individual, associated with body and subtle faculties, is called:"
  },
  {
   "id": "b782",
   "section": "Tantrasāra — Chapter 8",
   "type": "verse",
   "voice": "verse",
   "text": "Paśu.",
   "directed": "[slowly] Paśu."
  },
  {
   "id": "b783",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The bound being.",
   "directed": "The bound being."
  },
  {
   "id": "b784",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Now, this is a particularly important distinction.",
   "directed": "Now, this is a particularly important distinction."
  },
  {
   "id": "b785",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The limitation isn’t simply that you’ve got a body.",
   "directed": "The limitation isn’t simply that you’ve got a body."
  },
  {
   "id": "b786",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "It’s that consciousness experiences its agency and knowledge in restricted forms and identifies itself with that condition.",
   "directed": "It’s that consciousness experiences its agency and knowledge in restricted forms and identifies itself with that condition."
  },
  {
   "id": "b787",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Abhinavagupta gives the resulting cognition in a wonderfully compact expression.",
   "directed": "Abhinavagupta gives the resulting cognition in a wonderfully compact expression."
  },
  {
   "id": "b788",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The sense is:",
   "directed": "[short pause] The sense is:"
  },
  {
   "id": "b789",
   "section": "Tantrasāra — Chapter 8",
   "type": "dialogue",
   "voice": "granny",
   "text": "“I know this particular thing now, I’m attached to it, and I’m doing something about it.”",
   "directed": "[short pause] “I know this particular thing now, I’m attached to it, and I’m doing something about it.”"
  },
  {
   "id": "b790",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "That’s the paśu.",
   "directed": "That’s the paśu."
  },
  {
   "id": "b791",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The restricted subject.",
   "directed": "The restricted subject."
  },
  {
   "id": "b792",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "And if you’ve ever spent an entire afternoon obsessing over one particular problem while forgetting the vastness of existence, you’ll appreciate the description.",
   "directed": "And if you’ve ever spent an entire afternoon obsessing over one particular problem while forgetting the vastness of existence, you’ll appreciate the description."
  },
  {
   "id": "b793",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "But we’re not finished.",
   "directed": "But we’re not finished."
  },
  {
   "id": "b794",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Because so far we’ve been describing the limited subject.",
   "directed": "Because so far we’ve been describing the limited subject."
  },
  {
   "id": "b795",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
