   "id": "b852",
   "section": "Tantrasāra — Chapter 8",
   "type": "verse",
   "voice": "verse",
   "text": "Guṇa-tattva.",
   "directed": "[slowly] Guṇa-tattva."
  },
  {
   "id": "b853",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The domain of the three qualities.",
   "directed": "The domain of the three qualities."
  },
  {
   "id": "b854",
   "section": "Tantrasāra — Chapter 8",
   "type": "verse",
   "voice": "verse",
   "text": "Guṇa.",
   "directed": "[slowly] Guṇa."
  },
  {
   "id": "b855",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Now, in Sāṃkhya philosophy these three are fundamental characteristics of Prakṛti.",
   "directed": "Now, in Sāṃkhya philosophy these three are fundamental characteristics of Prakṛti."
  },
  {
   "id": "b856",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "But Abhinavagupta explicitly distinguishes an agitated condition of the guṇas in his account.",
