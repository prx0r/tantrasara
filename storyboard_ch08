  {
   "id": "b54",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Now, don’t imagine this is a universal property like all chairs having something in common.",
   "directed": "Now, don’t imagine this is a universal property like all chairs having something in common."
  },
  {
   "id": "b55",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "We’re not merely classifying objects.",
   "directed": "We’re not merely classifying objects."
