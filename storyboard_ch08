  {
   "id": "b56",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "We’re speaking of the conscious reality through which all these worlds and their distinctions appear.",
   "directed": "We’re speaking of the conscious reality through which all these worlds and their distinctions appear."
  },
  {
   "id": "b57",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "But suppose something pervades only a particular group of things.",
   "directed": "But suppose something pervades only a particular group of things."
