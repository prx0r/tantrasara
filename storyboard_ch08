  },
  {
   "id": "b857",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "And he makes a point of saying that this separate guṇa-tattva is not recognised in precisely this form by the Sāṃkhyas.",
   "directed": "And he makes a point of saying that this separate guṇa-tattva is not recognised in precisely this form by the Sāṃkhyas."
  },
  {
   "id": "b858",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "So this is a distinctive moment in his analysis.",
   "directed": "So this is a distinctive moment in his analysis."
  },
  {
   "id": "b859",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Right.",
   "directed": "[short pause] Right."
  },
