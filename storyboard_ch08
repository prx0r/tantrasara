  {
   "id": "b66",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Now, the earth tattva isn’t merely that handful of dirt you picked up in the garden.",
   "directed": "Now, the earth tattva isn’t merely that handful of dirt you picked up in the garden."
  },
  {
   "id": "b67",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "It’s the principle characterised by qualities such as solidity, hardness and grossness.",
   "directed": "It’s the principle characterised by qualities such as solidity, hardness and grossness."
  },
  {
   "id": "b68",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "And this principle pervades the entire range of worlds associated with it, from Kālagni to Vīrabhadra.",
   "directed": "And this principle pervades the entire range of worlds associated with it, from Kālagni to Vīrabhadra."
