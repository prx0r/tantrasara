   "id": "b50",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "The great universal.",
   "directed": "The great universal."
  },
  {
   "id": "b51",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "And what is this universal reality?",
   "directed": "And what is this universal reality?"
