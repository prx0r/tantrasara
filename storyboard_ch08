   "id": "b801",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Limited agency.",
   "directed": "Limited agency."
  },
  {
   "id": "b802",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "It contains two elements.",
   "directed": "It contains two elements."
  },
  {
   "id": "b803",
   "section": "Tantrasāra — Chapter 8",
   "type": "verse",
   "voice": "verse",
