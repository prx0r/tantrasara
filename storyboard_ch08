  },
  {
   "id": "b25",
   "section": "Tantrasāra — Chapter 8",
   "type": "narration",
   "voice": "granny",
   "text": "Because today we’re going to investigate the essential nature of the tattvas.",
   "directed": "Because today we’re going to investigate the essential nature of the tattvas."
